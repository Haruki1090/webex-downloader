{
    "manifest_version": 3,
    "name": "Webex 動画ダウンローダー",
    "version": "1.0",
    "description": "Webexの動画を簡単にダウンロードするための拡張機能",
    "permissions": ["activeTab", "scripting", "downloads"],
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "images/icon16.png",
        "48": "images/icon48.png",
        "128": "images/icon128.png"
      }
    },
    "icons": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    },
    "content_scripts": [
      {
        "matches": ["*://*.webex.com/*", "*://*/*.webex.com/*"],
        "js": ["content.js"]
      }
    ]
  }